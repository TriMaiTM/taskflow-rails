<%= form_with model: [project, task], class: "form-card" do |form| %>
  <% if task.errors.any? %>
    <ul>
      <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="form-field">
    <%= form.label :title, "Tiêu đề", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="form-field">
    <%= form.label :description, "Mô tả", class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 6 %>
  </div>

  <div class="form-field">
    <%= form.label :status, "Trạng thái", class: "form-label" %>
    <%= form.select :status,
      Task.statuses.keys.map { |status| [status.humanize, status] }, {}, { class: "form-control" } %>
  </div>

  <div class="form-field">
    <%= form.label :due_on, "Deadline", class: "form-label" %>
    <%= form.date_field :due_on, class: "form-control" %>
  </div>

  <div class="form-field">
    <%= form.label :files, "Tệp đính kèm", class: "form-label" %>
    <%= form.file_field :files, class: "form-control", multiple: true %>
  </div>

  <%= form.submit "Lưu thay đổi", class: "button button--secondary" %>
<% end %>
