<section class="page-header">
  <div>
    <h1>Dự án của tôi</h1>

    <p class="page-header__description">
      Tổ chức công việc, theo dõi tiến độ và hoàn thành mục tiêu.
    </p>
  </div>

  <%= link_to "+ Tạo dự án",
    new_project_path,
    class: "button button--primary" %>
</section>

<% if @projects.any? %>
  <section class="card-grid">
    <%= render @projects %>
  </section>
<% else %>
  <section class="empty-state">
    <div class="empty-state__icon">📁</div>

    <h2>Chưa có dự án</h2>

    <p>
      Tạo dự án đầu tiên để bắt đầu quản lý công việc.
    </p>

    <%= link_to "Tạo dự án đầu tiên",
      new_project_path,
      class: "button button--primary" %>
  </section>
<% end %>